numbers = []
print("Enter numbers one per line. Type 'done' when finished.")

while True:
    text = input("> ").strip()
    if text.lower() == "done":
        break
    try:
        numbers.append(float(text))
    except ValueError:
        print("That's not a number, try again.")

if numbers:
    total = sum(numbers)
    print(f"Count: {len(numbers)}  Sum: {total}  Average: {total / len(numbers):.2f}")
else:
    print("No numbers entered.")
